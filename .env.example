# GradeSpot frontend — environment placeholders.
# Copy to .env.local and fill in when each integration lands.
# NOTHING here is required for the scaffold to build or run.
# Never commit real keys — .env.local is git-ignored.

# --- Supabase (lead forms + chatbot knowledge base, Phase 3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI chatbot (Vercel AI SDK, /api/chat route, Phase 3) ---
# GroqCloud free tier (Llama 3.3) — get a key at https://console.groq.com
GROQ_API_KEY=
# Google AI Studio (Gemini Flash) — get a key at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Lead alerts (n8n / Meta WhatsApp Cloud API webhooks, Phase 3) ---
N8N_LEAD_WEBHOOK_URL=
